{
  "manifest_version": 3,
  "name": "NQiya - نقية",
  "version": "1.0.0",
  "description": "راجع تعليقاتك ومنشوراتك القديمة على فيسبوك قبل سنة تختارها — فحص ومعاينة ونسخة احتياطية فقط.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["*://*.facebook.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "نقية"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.facebook.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
